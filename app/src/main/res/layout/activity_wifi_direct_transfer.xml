<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/med_surface"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/wifiTitleText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Wi-Fi Direct Secure Transfer"
            android:textColor="@color/med_green_primary"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/wifiStatusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Preparing..."
            android:textColor="@color/med_text_primary"
            android:textSize="16sp" />

        <ImageView
            android:id="@+id/wifiQrImage"
            android:layout_width="240dp"
            android:layout_height="240dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="20dp"
            android:contentDescription="Wi-Fi Direct QR code"
            android:visibility="gone" />

        <Button
            android:id="@+id/wifiScanButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="20dp"
            android:backgroundTint="@color/med_green_primary"
            android:text="Scan Wi-Fi Direct QR"
            android:textAllCaps="false"
            android:textColor="@color/white" />

        <TextView
            android:id="@+id/wifiLogText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/medical_card_bg"
            android:padding="14dp"
            android:text="Ready."
            android:textColor="@color/med_text_secondary"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/wifiReceivedDataText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/medical_card_bg"
            android:padding="14dp"
            android:text=""
            android:textColor="@color/med_text_primary"
            android:textSize="14sp" />
    </LinearLayout>
</ScrollView>
